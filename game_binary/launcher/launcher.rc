#include <windows.h>

#ifdef H5X_DUEL
1 ICON "H5X-Duel.ico"
#define DESCRIPTION "H5X Duel"
#define FILENAME "H5X-Duel.exe"
#else
1 ICON "H5X.ico"
#define DESCRIPTION "H5X"
#define FILENAME "H5X.exe"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", DESCRIPTION
            VALUE "ProductName", "Heroes Expansion (H5X)"
            VALUE "OriginalFilename", FILENAME
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
